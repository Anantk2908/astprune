# Copy to .env if you want to change a default. Nothing here is secret and no API key is needed.

# Folder that file paths passed to the MCP tool are relative to.
# Default: the folder the server is started from.
ASTPRUNE_ROOT=/path/to/the/repository/you/are/working/on

# Ranking used by the server: auto | hybrid | trained | bm25
# auto uses the trained ranker when a checkpoint exists, and plain BM25 otherwise.
ASTPRUNE_SCORER=auto

# Trained ranker folder. Default: checkpoints/ranker/best
ASTPRUNE_CHECKPOINT=checkpoints/ranker/best

# cuda or cpu. Default: cuda when available.
ASTPRUNE_DEVICE=cuda

# Where bare clones of the benchmark repositories go (about 15 GB for all splits).
ASTPRUNE_REPO_DIR=data/repos

# Where Hugging Face datasets and models are cached. Default: data/cache/hf
HF_HOME=data/cache/hf
